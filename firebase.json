{
  "hosting": {
    "public": "dist", // Folder containing the built website

    "ignore": [
      "firebase.json", // Don't deploy this config file
      "**/.*", // Ignore hidden files
      "**/node_modules/**" // Ignore dependencies
    ],

    "rewrites": [
      {
        "source": "**", // Handle all routes
        "destination": "/index.html" // Let React Router handle navigation
      }
    ],

    "headers": [
      {
        "source": "**/*.@(js|css|woff2)", // Apply caching to JS, CSS and fonts
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
            // Cache versioned files for one year
          }
        ]
      }
    ]
  }
}
